server {
    listen 80;
    server_name enauth.example.com;

    # Redirect all HTTP traffic to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name enauth.example.com;

    ssl_certificate     /etc/letsencrypt/live/enauth.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/enauth.example.com/privkey.pem;

    # 100 MiB files plus multipart overhead. EnAuth separately enforces a
    # 2 MiB default limit for ordinary API requests, including chunked bodies.
    client_max_body_size 105m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300;
    }
}
