# EnAuth Server Configuration

# Server Settings
HOST=0.0.0.0
PORT=8888
DEBUG=false

# Database
DB_PATH=enauth.db
BACKUP_DIR=backups
BACKUP_RETENTION=14
# 0 disables scheduled backups. Signing keys are included only in encrypted form.
AUTO_BACKUP_HOURS=24
BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Discord application client ID used to build the OAuth invite link in the panel.
DISCORD_CLIENT_ID=

# SSL/TLS (Optional - leave empty for HTTP)
SSL_CERT=
SSL_KEY=

# Default Admin Account (created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS Origins (comma-separated list, e.g., http://localhost:3000,https://example.com)
# Leave empty or use * for development (not recommended for production)
CORS_ORIGINS=*
TRUST_PROXY_HEADERS=false
# Required when TRUST_PROXY_HEADERS=true. Only these reverse-proxy socket peers
# may supply forwarding headers. Mailcow commonly uses 172.22.1.0/24.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Exact browser origins allowed to make cookie-authenticated mutations.
CSRF_TRUSTED_ORIGINS=https://auth.example.com
COOKIE_SECURE=true
MAX_REQUEST_BYTES=110100480
# Non-upload requests keep a separate small limit, including chunked requests.
MAX_JSON_BYTES=2097152
MAX_BUILD_BYTES=104857600

# Rate Limiting (requests per minute)
RATE_LIMIT_INIT=20
RATE_LIMIT_NEWS=15
RATE_LIMIT_LOGIN=8
RATE_LIMIT_HEARTBEAT=60
RATE_LIMIT_LOGOUT=20
RATE_LIMIT_VALIDATE=30
RATE_LIMIT_DOWNLOAD=10

# Session Settings
ADMIN_SESSION_HOURS=8
SESSION_DURATION=86400
SESSION_TOKEN_SECONDS=300
DOWNLOAD_TICKET_SECONDS=60
REQUIRE_SESSION_HWID=true
# Keep true only during the old-SDK migration window, then set false.
ALLOW_LEGACY_PROTOCOL=true

# Security — lookup and reversible storage must use independent random secrets.
LICENSE_LOOKUP_KEY_ID=v1
LICENSE_LOOKUP_KEY=replace-with-at-least-32-random-characters
LICENSE_LOOKUP_PREVIOUS_KEYS={}
LICENSE_ENCRYPTION_KEY_ID=v1
LICENSE_ENCRYPTION_KEY=replace-with-a-different-32-character-random-secret
LICENSE_ENCRYPTION_PREVIOUS_KEYS={}
# Legacy compatibility only. Keep the old value here while decrypting pre-v17 keys,
# then remove it after every stored license has been re-encrypted.
LICENSE_KEY_PEPPER=
RESPONSE_SIGNING_KEY_PATH=response-signing-key.pem
# Optional: host path to the PEM certificate used by your reverse proxy.
TLS_CERTIFICATE_PATH=
MAX_LOGIN_STRIKES=5
TIMESTAMP_TOLERANCE=60
NONCE_CACHE_SIZE=10000
NONCE_TTL=120

# Logging
LOG_LEVEL=INFO
LOG_FILE=server.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=2
